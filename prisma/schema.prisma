generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANDFIGHTER
  VC
  ADMIN
}

enum TransferStatus {
  AWAITING_RECEIVER
  RECEIVER_ACCEPTED_AWAITING_VC
  RECEIVER_REJECTED
  VC_REJECTED
  VC_APPROVED_ACTIVE
  RETURN_AWAITING_ORIGINAL
  RETURN_ACCEPTED_AWAITING_VC
  COMPLETED
  CANCELLED
}

enum ExpectedEndMode {
  SPECIFIC_TIME
  UNTIL_SHIFT_END
}

enum ReturnRequestStatus {
  AWAITING_ORIGINAL
  ORIGINAL_ACCEPTED_AWAITING_VC
  ORIGINAL_REJECTED
  VC_APPROVED_COMPLETED
  VC_REJECTED
}

enum NotificationType {
  TRANSFER_CREATED
  TRANSFER_RECEIVER_ACCEPTED
  TRANSFER_RECEIVER_REJECTED
  TRANSFER_VC_APPROVED
  TRANSFER_VC_REJECTED
  TRANSFER_STARTED
  TRANSFER_EXPECTED_END
  RETURN_CREATED
  RETURN_ORIGINAL_ACCEPTED
  RETURN_ORIGINAL_REJECTED
  RETURN_VC_APPROVED
  RETURN_VC_REJECTED
  TEST
}

enum PushDeliveryStatus {
  PENDING
  SENT
  FAILED
  PERMANENT_FAILURE
  NO_ACTIVE_DEVICE
}

model User {
  id                 String     @id @default(cuid())
  name               String
  role               UserRole
  employeeNumber     String?    @unique
  loginIdentifier    String     @unique
  passwordHash       String
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastLoginAt        DateTime?
  sessions           Session[]
  auditLogs          AuditLog[] @relation("ActorAuditLogs")
  targetedAuditLogs  AuditLog[] @relation("TargetAuditLogs")
  givenTransfers     ShiftTransfer[] @relation("GivenTransfers")
  receivedTransfers  ShiftTransfer[] @relation("ReceivedTransfers")
  createdReturns     ReturnRequest[] @relation("ReturnCreatedBy")
  answeredReturns     ReturnRequest[] @relation("ReturnAnsweredBy")
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  @@index([role])
  @@index([isActive])
}

model ShiftTransfer {
  id                             String         @id @default(cuid())
  transferNumber                 String         @unique
  giverUserId                    String
  receiverUserId                 String
  giverEmployeeNumberSnapshot    String
  receiverEmployeeNumberSnapshot String
  giverNameSnapshot              String
  receiverNameSnapshot           String
  requestedStartAt               DateTime
  expectedEndMode                ExpectedEndMode @default(UNTIL_SHIFT_END)
  expectedEndAt                  DateTime?
  comment                        String?
  status                         TransferStatus @default(AWAITING_RECEIVER)
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt
  receiverRespondedAt            DateTime?
  receiverResponseComment        String?
  vcDecidedAt                    DateTime?
  vcDecision                     String?
  vcComment                      String?
  activatedAt                    DateTime?
  completedAt                    DateTime?
  giver                          User           @relation("GivenTransfers", fields: [giverUserId], references: [id], onDelete: Restrict)
  receiver                       User           @relation("ReceivedTransfers", fields: [receiverUserId], references: [id], onDelete: Restrict)
  returnRequests                 ReturnRequest[]
  notifications                  Notification[]

  @@index([giverUserId])
  @@index([receiverUserId])
  @@index([status])
  @@index([createdAt])
}

model ReturnRequest {
  id                              String              @id @default(cuid())
  returnNumber                    String              @unique
  transferId                      String
  createdByUserId                 String
  originalUserId                  String
  currentHolderUserId             String
  originalNameSnapshot            String
  originalEmployeeNumberSnapshot  String
  currentHolderNameSnapshot       String
  currentHolderEmployeeNumberSnapshot String
  requestedReturnAt               DateTime
  comment                         String?
  status                          ReturnRequestStatus @default(AWAITING_ORIGINAL)
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  originalRespondedAt             DateTime?
  originalAcceptedAt              DateTime?
  originalResponseComment         String?
  vcDecidedAt                     DateTime?
  vcDecision                      String?
  vcComment                       String?
  completedAt                     DateTime?
  transfer                        ShiftTransfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)
  createdBy                       User                @relation("ReturnCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  originalUser                    User                @relation("ReturnAnsweredBy", fields: [originalUserId], references: [id], onDelete: Restrict)
  notifications                   Notification[]

  @@index([transferId])
  @@index([createdByUserId])
  @@index([originalUserId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  shiftTransferId String?
  returnRequestId String?
  type            NotificationType
  title           String
  body            String
  link            String
  scheduledFor    DateTime?
  publishedAt     DateTime?
  readAt          DateTime?
  openedAt        DateTime?
  cancelledAt     DateTime?
  uniqueKey       String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipient       User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  shiftTransfer   ShiftTransfer?   @relation(fields: [shiftTransferId], references: [id], onDelete: Cascade)
  returnRequest   ReturnRequest?   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  deliveries      PushDelivery[]

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([scheduledFor])
  @@index([publishedAt])
  @@index([cancelledAt])
}

model PushSubscription {
  id          String         @id @default(cuid())
  userId      String
  endpoint    String         @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceName  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  PushDelivery[]

  @@index([userId])
  @@index([revokedAt])
}

model PushDelivery {
  id                 String             @id @default(cuid())
  notificationId     String
  pushSubscriptionId String?
  status             PushDeliveryStatus @default(PENDING)
  attemptCount       Int                @default(0)
  sentAt             DateTime?
  failedAt           DateTime?
  lastError          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  notification       Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushSubscription   PushSubscription?  @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([pushSubscriptionId])
  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorUserId  String?
  actorRole    UserRole?
  action       String
  targetUserId String?
  description  String
  createdAt    DateTime  @default(now())
  actor        User?     @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?     @relation("TargetAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

model LoginAttempt {
  id              String   @id @default(cuid())
  identifier      String
  ipAddress       String?
  wasSuccessful   Boolean
  failureReason   String?
  createdAt       DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}
