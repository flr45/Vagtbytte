generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BRANDFIGHTER
  VC
  ADMIN
}

enum TransferStatus {
  AWAITING_RECEIVER
  RECEIVER_ACCEPTED_AWAITING_VC
  RECEIVER_REJECTED
  VC_REJECTED
  VC_APPROVED_AWAITING_ACTIVATION
  VC_APPROVED_ACTIVE
  RETURN_AWAITING_ORIGINAL
  RETURN_ACCEPTED_AWAITING_VC
  RETURN_APPROVED_AWAITING_EXECUTION
  COMPLETED
  CANCELLED
}

enum ExpectedEndMode {
  SPECIFIC_TIME
  UNTIL_SHIFT_END
}

enum ReturnRequestStatus {
  AWAITING_ORIGINAL
  ORIGINAL_ACCEPTED_AWAITING_VC
  ORIGINAL_REJECTED
  VC_REJECTED
  VC_APPROVED_AWAITING_EXECUTION
  COMPLETED
  CANCELLED
}

model User {
  id                    String            @id @default(uuid())
  role                  UserRole
  name                  String
  employeeNumber        String?           @unique
  login                 String?           @unique
  passwordHash          String
  mustChangeAccessCode  Boolean           @default(false)
  hasAdminAccess        Boolean           @default(false)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  outgoingTransfers     Transfer[]        @relation("OutgoingTransfers")
  incomingTransfers     Transfer[]        @relation("IncomingTransfers")
  approvals             Transfer[]        @relation("ApprovedTransfers")
  createdNotifications  Notification[]    @relation("CreatedNotifications")
  notifications         UserNotification[]
  pushSubscriptions     PushSubscription[]
  auditLogs             AuditLog[]        @relation("ActorAuditLogs")
  availability          FirefighterAvailability?
  firefighterAssignments AlarmAssignment[] @relation("AlarmAssignmentFirefighter")
  vcAssignments         AlarmAssignment[] @relation("AlarmAssignmentVc")
  alarmFollowUps        AlarmFollowUp[]
  sessions              Session[]
  loginAttempts         LoginAttempt[]
}

model Transfer {
  id                  String              @id @default(uuid())
  fromFirefighterId   String
  toFirefighterId     String?
  approvedById        String?
  shiftStart          DateTime
  shiftEnd            DateTime
  status              TransferStatus      @default(AWAITING_RECEIVER)
  expectedEndMode     ExpectedEndMode?
  expectedEndAt       DateTime?
  message             String?
  returnStatus        ReturnRequestStatus?
  returnRequestedAt   DateTime?
  returnRespondedAt   DateTime?
  returnApprovedAt    DateTime?
  returnedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  fromFirefighter     User                @relation("OutgoingTransfers", fields: [fromFirefighterId], references: [id])
  toFirefighter       User?               @relation("IncomingTransfers", fields: [toFirefighterId], references: [id])
  approvedBy          User?               @relation("ApprovedTransfers", fields: [approvedById], references: [id])
  notifications       Notification[]
  alarmAssignments    AlarmAssignment[]

  @@index([fromFirefighterId, status])
  @@index([toFirefighterId, status])
  @@index([shiftStart, shiftEnd])
}

model FirefighterAvailability {
  userId               String   @id
  isAvailable          Boolean  @default(false)
  availableUntil       DateTime?
  sourceTransferId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable, availableUntil])
}

model AlarmMessage {
  id                   String            @id @default(uuid())
  sourceAddress        String
  body                 String
  sourceKey            String?
  externalMessageId    String?
  receivedAt           DateTime          @default(now())
  stationCode          String?
  isPrimary            Boolean           @default(false)
  isFollowUp           Boolean           @default(false)
  groupedAlarmId       String?
  groupedAlarm         AlarmMessage?     @relation("AlarmGroup", fields: [groupedAlarmId], references: [id], onDelete: SetNull)
  followUpMessages     AlarmMessage[]    @relation("AlarmGroup")
  assignments          AlarmAssignment[]
  followUps            AlarmFollowUp[]

  @@unique([sourceAddress, externalMessageId])
  @@index([receivedAt])
  @@index([stationCode, receivedAt])
  @@index([groupedAlarmId, receivedAt])
}

model AlarmAssignment {
  id                   String       @id @default(uuid())
  alarmMessageId       String
  firefighterId        String
  vcId                 String?
  sourceTransferId     String?
  assignedAt           DateTime     @default(now())
  endedAt              DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  alarmMessage         AlarmMessage @relation(fields: [alarmMessageId], references: [id], onDelete: Cascade)
  firefighter          User         @relation("AlarmAssignmentFirefighter", fields: [firefighterId], references: [id])
  vc                   User?        @relation("AlarmAssignmentVc", fields: [vcId], references: [id])
  sourceTransfer       Transfer?    @relation(fields: [sourceTransferId], references: [id], onDelete: SetNull)

  @@index([firefighterId, endedAt])
  @@index([alarmMessageId, endedAt])
  @@index([vcId, endedAt])
}

model AlarmFollowUp {
  id                   String       @id @default(uuid())
  alarmMessageId       String
  userId               String
  status               String
  respondedAt          DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  alarmMessage         AlarmMessage @relation(fields: [alarmMessageId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alarmMessageId, userId])
  @@index([userId, respondedAt])
}

model Notification {
  id                   String             @id @default(uuid())
  type                 String
  title                String
  body                 String
  link                 String?
  transferId           String?
  createdById          String?
  createdAt            DateTime           @default(now())
  transfer             Transfer?          @relation(fields: [transferId], references: [id], onDelete: Cascade)
  createdBy            User?              @relation("CreatedNotifications", fields: [createdById], references: [id], onDelete: SetNull)
  recipients           UserNotification[]

  @@index([createdAt])
  @@index([transferId])
}

model UserNotification {
  id                   String       @id @default(uuid())
  userId               String
  notificationId       String
  readAt               DateTime?
  openedAt             DateTime?
  createdAt            DateTime     @default(now())
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification          Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id                   String   @id @default(uuid())
  userId               String
  endpoint             String   @unique
  p256dh               String
  auth                 String
  userAgent            String?
  isActive             Boolean  @default(true)
  lastSuccessAt        DateTime?
  lastFailureAt        DateTime?
  lastError            String?
  failureCount         Int      @default(0)
  revokedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model AuditLog {
  id                   String   @id @default(uuid())
  actorUserId          String?
  actorRole            UserRole?
  action               String
  description          String
  metadata             Json?
  createdAt            DateTime @default(now())
  actor                User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

model Session {
  id                   String   @id @default(uuid())
  tokenHash            String   @unique
  userId               String
  expiresAt            DateTime
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id                   String   @id @default(uuid())
  identifierHash       String
  ipHash               String?
  wasSuccessful        Boolean  @default(false)
  createdAt            DateTime @default(now())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
}
