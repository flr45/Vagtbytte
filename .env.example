DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
AUTH_SECRET="udskift-med-en-lang-tilfaeldig-noegle"
APP_BASE_URL="https://sbr-portal.racher.dk"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_VC_PASSWORD="Vc123456!"
SEED_FIREFIGHTER_PASSWORD="Brand123!"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:lokal@vagtbytte.test"
NOTIFICATIONS_DISABLE_PUSH="true"

# MFA håndhæves som standard kun for ADMIN og brugere med eksplicit administratoradgang.
# VC og brugere med alene Operativ Portal-adgang kræver ikke MFA.
# Tilladte værdier: admin, all, off. Ældre "privileged" behandles som admin-politikken.
# "off" bør kun bruges midlertidigt ved nødprocedure.
MFA_ENFORCEMENT_MODE="admin"
MFA_ISSUER="SBR Portal"
# Valgfri dedikeret 32-byte nøgle (base64 eller 64 hex-tegn). Hvis tom, afledes en separat
# AES-256-GCM nøgle fra AUTH_SECRET med domæneadskillelse.
MFA_ENCRYPTION_KEY=""

# Nye v2-backups inkluderer Operativ Portals billeder og dokumenter. Den nuværende
# backupmotor samler filerne i hukommelsen før komprimering/kryptering, så der er en
# konservativ standardgrænse på 512 MiB operative filer. Hæv kun efter RAM-vurdering.
BACKUP_MAX_OPERATIONAL_BYTES="536870912"

# SMTP bruges både til mailrapporter og nulstilling af glemte adgangskoder.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SBR Portal <no-reply@racher.dk>"
SMTP_FROM_NAME="SBR Portal"
SMTP_HELO_NAME="sbr-portal.racher.dk"
SMTP_ALLOW_SELF_SIGNED="false"

# Dataminimering og slettefrister. Værdierne skal godkendes af den dataansvarlige
# ud fra de konkrete formål, lovgrundlag og eventuelle dokumentationskrav.
# Sæt 0 for at deaktivere en automatisk slettefrist, hvis der findes et dokumenteret behov.
ALARM_DATA_RETENTION_DAYS="90"
BACKUP_MAX_AGE_DAYS="90"
LOGIN_ATTEMPT_RETENTION_DAYS="90"
NOTIFICATION_RETENTION_DAYS="180"
AUDIT_LOG_RETENTION_DAYS="365"
OPERATIONAL_RECENT_RETENTION_DAYS="30"
# Slettefingeraftryk bevares længere end de administrerede backups, så en restore ikke
# kan genindføre brugere, der tidligere er slettet/anonymiseret.
ERASURE_TOMBSTONE_RETENTION_DAYS="365"
# Udløbne sessioner, MFA-challenges og password-reset-tokens slettes automatisk.
# Retention køres som standard hver 6. time af notifikations-workeren.
DATA_RETENTION_INTERVAL_MS="21600000"
DATA_RETENTION_DISABLED="false"

BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_VC_USERNAME=""
BOOTSTRAP_VC_PASSWORD=""
