# Rå alarmtekster, afsendernumre og tilhørende alarmnotifikationer slettes efter 90 dage.
# AlarmStatistic bevares, så anonymiseret statistik fortsat virker. Sæt 0 for at deaktivere.
ALARM_DATA_RETENTION_DAYS="90"
# Alle manuelle og automatiske backupfiler slettes senest efter 90 dage.
# Automatiske backups begrænses desuden fortsat af BACKUP_RETENTION_COUNT. Sæt 0 for at deaktivere.
BACKUP_MAX_AGE_DAYS="90"
# Retention køres som standard hver 6. time af notifikations-workeren.
DATA_RETENTION_INTERVAL_MS="21600000"
DATA_RETENTION_DISABLED="false"

